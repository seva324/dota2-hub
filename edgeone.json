{
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "nodeVersion": "22.11.0",
  "nodeFunctionsConfig": {
    "maxDuration": 60
  },
  "cloudFunctions": {
    "nodejs": {
      "includeFiles": [
        "public/images/mirror/manifest.json",
        "apps/web/public/images/mirror/manifest.json",
        "apps/web/dist/images/mirror/manifest.json"
      ]
    }
  },
  "node-functions": {
    "included_files": [
      "public/images/mirror/manifest.json",
      "apps/web/public/images/mirror/manifest.json",
      "apps/web/dist/images/mirror/manifest.json"
    ]
  },
  "redirects": [],
  "rewrites": [
    {
      "source": "/api/sync-news",
      "destination": "/api/cron?action=sync-news"
    },
    {
      "source": "/api/sync-liquipedia",
      "destination": "/api/cron?action=sync-liquipedia"
    }
  ],
  "headers": [
    {
      "source": "/images/mirror/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/asset-image*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/bo3-image*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/live-hero*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=15, s-maxage=15, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/api/upcoming*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=180"
        }
      ]
    },
    {
      "source": "/api/matches*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/tournaments*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/news*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/match-page*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/ept-ranking*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/primary-leagues*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=180, s-maxage=180, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/images/mirror/*",
      "cacheTtl": 86400
    },
    {
      "source": "/api/asset-image*",
      "cacheTtl": 86400
    },
    {
      "source": "/api/bo3-image*",
      "cacheTtl": 86400
    },
    {
      "source": "/assets/*",
      "cacheTtl": 31536000
    },
    {
      "source": "/api/live-hero*",
      "cacheTtl": 15
    },
    {
      "source": "/api/upcoming*",
      "cacheTtl": 60
    },
    {
      "source": "/api/matches*",
      "cacheTtl": 120
    },
    {
      "source": "/api/tournaments*",
      "cacheTtl": 120
    },
    {
      "source": "/api/news*",
      "cacheTtl": 120
    },
    {
      "source": "/api/match-page*",
      "cacheTtl": 600
    },
    {
      "source": "/api/ept-ranking*",
      "cacheTtl": 300
    },
    {
      "source": "/api/primary-leagues*",
      "cacheTtl": 180
    }
  ]
}
